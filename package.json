{
  "name": "web3-ai-agent",
  "displayName": "Web3 AI Agent",
  "description": "Self-sufficient AI agent for Next.js and Web3 development on Sui and Solana blockchains",
  "version": "1.0.0",
  "publisher": "web3-dev-tools",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "web3",
    "nextjs",
    "solana",
    "sui",
    "blockchain",
    "smart-contracts",
    "dapp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "web3-ai-agent.openChat",
        "title": "Open AI Agent Chat",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.analyzeProject",
        "title": "Analyze Project Structure",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.generateComponent",
        "title": "Generate Next.js Component",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.generateSmartContract",
        "title": "Generate Smart Contract",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.optimizeCode",
        "title": "Optimize Code",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.runTests",
        "title": "Run Tests with AI Analysis",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.deployContract",
        "title": "Deploy Smart Contract",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.auditSecurity",
        "title": "Security Audit",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.optimizeNodeJS",
        "title": "Optimize Node.js App",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.generateAPI",
        "title": "Generate API Endpoints",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.designComponents",
        "title": "Design UI/UX Components",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.auditAccessibility",
        "title": "Audit Accessibility",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.showTaskDetails",
        "title": "Show Task Details",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.startTerminalMonitoring",
        "title": "Start Terminal Monitoring",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.stopTerminalMonitoring",
        "title": "Stop Terminal Monitoring",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.toggleAutoFix",
        "title": "Toggle Auto-Fix",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.analyzeTerminalError",
        "title": "Analyze Terminal Error",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.testLocalLLM",
        "title": "Test Local LLM Connection",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.listLocalModels",
        "title": "List Local LLM Models",
        "category": "Web3 AI Agent"
      },
      {
        "command": "web3-ai-agent.configureLocalLLM",
        "title": "Configure Local LLM",
        "category": "Web3 AI Agent"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "web3-ai-agent.analyzeProject",
          "when": "explorerResourceIsFolder",
          "group": "web3-ai-agent"
        }
      ],
      "editor/context": [
        {
          "command": "web3-ai-agent.optimizeCode",
          "when": "editorHasSelection",
          "group": "web3-ai-agent"
        }
      ]
    },
    "configuration": {
      "title": "Web3 AI Agent",
      "properties": {
        "web3-ai-agent.deepseekApiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key",
          "scope": "application"
        },
        "web3-ai-agent.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key",
          "scope": "application"
        },
        "web3-ai-agent.claudeApiKey": {
          "type": "string",
          "default": "",
          "description": "Claude API Key",
          "scope": "application"
        },
        "web3-ai-agent.customApiEndpoint": {
          "type": "string",
          "default": "",
          "description": "Custom API Endpoint URL",
          "scope": "application"
        },
        "web3-ai-agent.customApiKey": {
          "type": "string",
          "default": "",
          "description": "Custom API Key",
          "scope": "application"
        },
        "web3-ai-agent.preferredModel": {
          "type": "string",
          "enum": [
            "deepseek",
            "gpt-4",
            "gpt-3.5-turbo",
            "claude-3-opus",
            "claude-3-sonnet",
            "local-llm",
            "custom"
          ],
          "default": "deepseek",
          "description": "Preferred AI model for code generation"
        },
        "web3-ai-agent.autoAnalyze": {
          "type": "boolean",
          "default": true,
          "description": "Automatically analyze project on startup"
        },
        "web3-ai-agent.suiNetwork": {
          "type": "string",
          "enum": [
            "mainnet",
            "testnet",
            "devnet",
            "localnet"
          ],
          "default": "testnet",
          "description": "Default Sui network"
        },
        "web3-ai-agent.solanaNetwork": {
          "type": "string",
          "enum": [
            "mainnet-beta",
            "testnet",
            "devnet",
            "localnet"
          ],
          "default": "devnet",
          "description": "Default Solana network"
        },
        "web3-ai-agent.terminalMonitoring.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start terminal monitoring on extension activation"
        },
        "web3-ai-agent.terminalMonitoring.autoFix": {
          "type": "boolean",
          "default": true,
          "description": "Automatically apply high-confidence fixes"
        },
        "web3-ai-agent.terminalMonitoring.confidence": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.1,
          "maximum": 1.0,
          "description": "Minimum confidence threshold for automatic fixes"
        },
        "web3-ai-agent.terminalMonitoring.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for detected errors and applied fixes"
        },
        "web3-ai-agent.localLLM.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local LLM endpoint URL"
        },
        "web3-ai-agent.localLLM.model": {
          "type": "string",
          "default": "codellama:7b",
          "description": "Local LLM model name"
        },
        "web3-ai-agent.localLLM.apiFormat": {
          "type": "string",
          "enum": [
            "ollama",
            "openai",
            "textgen",
            "vllm",
            "custom"
          ],
          "default": "ollama",
          "description": "Local LLM API format"
        },
        "web3-ai-agent.localLLM.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for local LLM (if required)"
        },
        "web3-ai-agent.localLLM.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.0,
          "maximum": 2.0,
          "description": "Temperature for local LLM responses"
        },
        "web3-ai-agent.localLLM.maxTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 100,
          "maximum": 8192,
          "description": "Maximum tokens for local LLM responses"
        },
        "web3-ai-agent.localLLM.timeout": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "Timeout for local LLM requests (milliseconds)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "web3-ai-agent",
          "title": "Web3 AI Agent",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "web3-ai-agent": [
        {
          "id": "web3-ai-agent.projectOverview",
          "name": "Project Overview",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "web3-ai-agent.tasks",
          "name": "AI Tasks",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "web3-ai-agent.notes",
          "name": "AI Notes",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "install-vsce": "npm install -g vsce",
    "build": "npm run compile && npm run package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "openai": "^4.20.0",
    "@anthropic-ai/sdk": "^0.9.0",
    "marked": "^9.1.0"
  }
}